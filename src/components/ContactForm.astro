---
//definiciones para que entienda el javascript

import {
    useTranslations,
    defaultLang,
    type Lang,
    type TranslationKey,
} from "../i18n";

const lang = (Astro.currentLocale ?? "es") as Lang;
const t = useTranslations(lang);


// añadimos aquí lo necesario para las variables que vamos a utilizar en el formulario
const claseCampo = "w-full rounded-lg border-slate-200 p-3 focus:border-blue-700 focus:outline-2 focus:outline-offset-0 focus:outline-blue-700";

// constante formulario
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID;
// constante endpoint 
const endpoint = formspreeId ? `https://formspree.io/f/${formspreeId}` : "";


//creamos las constantes que usaremos en el formulario
const opciones = [
    {value: "design", label: t("form.service.design")},
    {value: "i18n", label: t("form.service.i18n")},
    {value: "optimization", label: t("form.service.optimization")},
    {value: "other", label: t("form.service.other")},
]
---

<!--- esta parte es para que entienda el html -->

<!-- vamos a la sección de CONTACTOS del HEADER DE COMPONENTS   -->
        <!-- el identificador es contacto que está en el header y la clase es paddiny es de 10 y pantalla mediana el padding es de 16 -->
<section id="contacto" class="py-10 md:py-16">


    <div class="contenedor">
        <h2 class = "mb-2">
             <!-- utilizamos la t que es la variable para traducir -->
        
        </h2>     


        <!-- aquí empieza el formulario -->
        <form action="#" method="post">
            <fieldset>
                <legend>Solicita información sobre nuestros servicios</legend>

                <div>
                    <label for="name">Nombre completo</label>
                    <input type="text" id="name" name="name" required />
                </div>
                <div>
                    <label for="email">Correo electrónico</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        required
                        aria-describedby="ayuda-email"
                    />
                    <small id="ayuda-email"
                        >Introduce un correo válido, por ejemplo
                        nombre@empresa.com</small
                    >
                </div>

                <!--  los div son divisiones  -->


                <div>
                    <!--  esto es para una etiqueta de texto -->
